// Prisma Schema - Sistema de Gestão de Canteiro de Obras e RDO
// Banco de dados: PostgreSQL (Otimizado para Neon Serverless)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // String com pooling (usada pela aplicação)
  directUrl = env("DIRECT_URL")   // String direta (usada para rodar as migrations)
}

// ==========================================
// USUÁRIOS E AUTENTICAÇÃO
// ==========================================

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  name         String
  role         UserRole      @default(WORKER)
  phone        String?
  cpf          String?       @unique
  crea         String?       // Registro CREA para engenheiros
  art          String?       // ART vinculada
  rrt          String?       // RRT para arquitetos
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?

  // Relacionamentos
  company      Company?      @relation(fields: [companyId], references: [id])
  companyId    String?
  projects     ProjectMember[]
  rdosCreated  RDO[]         @relation("RdoCreator") 
  photos       Photo[]
  signatures   Signature[]
  emergencies  Emergency[]
  sessions     Session[]

  @@index([email])
  @@index([companyId])
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([token])
  @@index([userId])
}

enum UserRole {
  ADMIN
  MANAGER
  ENGINEER
  TECHNICIAN
  WORKER
}

// ==========================================
// EMPRESA E PROJETOS
// ==========================================

model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String   @unique
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  
  // REGRA GLOBAL: Prazo padrão de retenção em dias para todas as obras da empresa
  mediaRetentionDays Int @default(90) 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  projects  Project[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  address         String
  city            String
  state           String
  zipCode         String?
  latitude        Float?
  longitude       Float?
  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  status          ProjectStatus @default(PLANNING)
  bimModelUrl     String?
  
  isActive        Boolean @default(true)
  mediaRetentionDays Int? 

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company     Company         @relation(fields: [companyId], references: [id])
  companyId   String
  members     ProjectMember[]
  rdos        RDO[]
  photos      Photo[]
  equipment   Equipment[]
  bimElements BIMElement[]
  emergencies Emergency[]

  @@index([companyId])
  @@index([status])
}

model ProjectMember {
  id       String     @id @default(cuid())
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String

  @@unique([userId, projectId])
  @@index([projectId])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum MemberRole {
  OWNER
  MANAGER
  ENGINEER
  TECHNICIAN
  MEMBER
}

// ==========================================
// RDO - RELATÓRIO DIÁRIO DE OBRA
// ==========================================

model RDO {
  id               String            @id @default(cuid())
  date             DateTime          @default(now())
  number           Int              
  status           RDOStatus         @default(DRAFT)
  
  // Localização
  latitude         Float?
  longitude        Float?
  address          String?
  
  // Clima
  weatherCondition WeatherCondition?
  temperature      Float?
  humidity         Float?
  windSpeed        Float?
  weatherNotes     String?
  
  // Período de trabalho
  workStartTime    DateTime?
  workEndTime      DateTime?
  lunchStartTime   DateTime?
  lunchEndTime     DateTime?
  
  // Observações gerais
  activities       String?           @db.Text
  observations     String?           @db.Text
  issues           String?           @db.Text
  authorSignature  String?           @db.Text // Base64 ou URL da Assinatura
  
  // Metadados de sincronização offline
  localId          String?           @unique
  syncedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

// Relacionamentos
  project        Project          @relation(fields: [projectId], references: [id])
  projectId      String
  createdBy      User             @relation("RdoCreator", fields: [createdById], references: [id])
  createdById    String
  workforce      Workforce[]
  equipmentUsage EquipmentUsage[]
  photos         Photo[]         
  signatures     Signature[]
  @@unique([projectId, number])
  @@index([projectId, date])
  @@index([createdById])
  @@index([status])
  @@index([localId])
}

enum RDOStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  APPROVED
  REJECTED
}

enum WeatherCondition {
  SUNNY
  PARTLY_CLOUDY
  CLOUDY
  RAINY
  STORMY
  WINDY
  FOGGY
}

// ==========================================
// MÃO DE OBRA
// ==========================================

model Workforce {
  id          String   @id @default(cuid())
  category    String   // Ex: Pedreiro, Servente, Eletricista
  quantity    Int
  hoursWorked Float?
  notes       String?

  rdo   RDO    @relation(fields: [rdoId], references: [id], onDelete: Cascade)
  rdoId String

  @@index([rdoId])
}

// ==========================================
// EQUIPAMENTOS
// ==========================================

model Equipment {
  id              String          @id @default(cuid())
  name            String
  type            String
  serialNumber    String?
  plate           String?         // Para veículos
  qrCode          String?         @unique
  barcode         String?         @unique
  status          EquipmentStatus @default(AVAILABLE)
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project   Project          @relation(fields: [projectId], references: [id])
  projectId String
  usage     EquipmentUsage[]

  @@index([projectId])
  @@index([qrCode])
  @@index([barcode])
}

model EquipmentUsage {
  id             String @id @default(cuid())
  horimeterStart Float?
  horimeterEnd   Float?
  hoursUsed      Float?
  fuelConsumed   Float?
  operatorName   String?
  notes          String?
  quantity       Int    @default(1) // <-- ADICIONE ESTA LINHA: Controla quantas ferramentas manuais foram usadas

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String
  rdo         RDO       @relation(fields: [rdoId], references: [id], onDelete: Cascade)
  rdoId       String

  @@index([rdoId])
  @@index([equipmentId])
}
enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  BROKEN
  RETIRED
}

// ==========================================
// FOTOS E OCORRÊNCIAS
// ==========================================

model Photo {
  id             String        @id @default(cuid())
  filename       String
  url            String
  thumbnailUrl   String?
  mimeType       String        @default("image/jpeg")
  size           Int           // Em bytes
  
  // Metadados automáticos
  latitude       Float?
  longitude      Float?
  compassBearing Float?        // Orientação da bússola
  timestamp      DateTime      @default(now())
  
  // Markup/Anotações
  hasMarkup      Boolean       @default(false)
  markupData     String?       @db.Text
  
  // Categorização
  category    PhotoCategory @default(GENERAL)
  description String?
  tags        String[]
  
  // QR/Barcode detectado
  scannedCode     String?
  scannedCodeType String?
  
  // Sincronização offline
  localId  String?   @unique
  syncedAt DateTime?
  createdAt DateTime @default(now())

  // Relacionamentos
  project      Project @relation(fields: [projectId], references: [id])
  projectId    String
  rdo          RDO?    @relation(fields: [rdoId], references: [id])
  rdoId        String?
  uploadedBy   User    @relation(fields: [uploadedById], references: [id])
  uploadedById String

  @@index([projectId])
  @@index([rdoId])
  @@index([category])
  @@index([localId])
}

enum PhotoCategory {
  GENERAL
  PROGRESS
  ISSUE
  SAFETY
  MATERIAL
  EQUIPMENT
  INSPECTION
}

// ==========================================
// ASSINATURAS DIGITAIS
// ==========================================

model Signature {
  id         String   @id @default(cuid())
  imageData  String   @db.Text // Base64 da assinatura
  signedAt   DateTime @default(now())
  ipAddress  String?
  deviceInfo String?
  latitude   Float?
  longitude  Float?

  user   User   @relation(fields: [userId], references: [id])
  userId String
  rdo    RDO    @relation(fields: [rdoId], references: [id])
  rdoId  String

  @@index([rdoId])
  @@index([userId])
}

// ==========================================
// BIM 4D
// ==========================================

model BIMElement {
  id           String           @id @default(cuid())
  guid         String           // GUID do elemento IFC
  name         String
  type         String           // Wall, Slab, Column, etc.
  level        String?          // Pavimento
  status       BIMElementStatus @default(PLANNED)
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  progress     Float            @default(0) // 0-100%
  bcfTopic     String?          // ID do tópico BCF
  notes        String?
  updatedAt    DateTime         @updatedAt

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  @@unique([projectId, guid])
  @@index([projectId])
  @@index([status])
}

enum BIMElementStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
  BLOCKED
}

// ==========================================
// EMERGÊNCIAS
// ==========================================

model Emergency {
  id          String          @id @default(cuid())
  type        EmergencyType
  description String?
  latitude    Float
  longitude   Float
  accuracy    Float?          // Precisão do GPS em metros
  status      EmergencyStatus @default(ACTIVE)
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())

  project       Project @relation(fields: [projectId], references: [id])
  projectId     String
  triggeredBy   User    @relation(fields: [triggeredById], references: [id])
  triggeredById String

  @@index([projectId])
  @@index([status])
}

enum EmergencyType {
  PANIC
  ACCIDENT
  FIRE
  MEDICAL
  STRUCTURAL
  OTHER
}

enum EmergencyStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

// ==========================================
// SINCRONIZAÇÃO OFFLINE (Fila de Sync)
// ==========================================

model SyncQueue {
  id         String     @id @default(cuid())
  entityType String     // RDO, Photo, etc.
  entityId   String     // ID local da entidade
  action     SyncAction
  payload    String     @db.Text
  retryCount Int        @default(0)
  lastError  String?
  status     SyncStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([entityType, entityId])
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
}

enum SyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

